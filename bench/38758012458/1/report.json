        {
          "expectDb": {
            "col": "orders",
            "min": 1
          }
        },
        {
          "expect": "طلبات الصيانة الخاصة بي"
        }
      ]
    },
    {
      "flow": "تنفيذ الطلب للفني",
      "steps": [
        {
          "role": "technician"
        },
        {
          "go": "/tech-requests"
        },
        {
          "click": "[data-act=accept]"
        },
        {
          "go": "/tech-active-orders"
        },
        {
          "click": "[data-act=set-delivering]"
        },
        {
          "click": "[data-act=set-done]"
        },
        {
          "click": "text:نعم، تمت"
        },
        {
          "role": "customer"
        },
        {
          "go": "/orders"
        },
        {
          "click": "[data-act=rate]"
        },
        {
          "fill": {
            "#rate-review": "خدمة ممتازة وفني محترف"
          }
        },
        {
          "click": "#submit-rating-btn"
        },
        {
          "expect": "تقييم الخدمة والفني"
        }
      ]
    }
