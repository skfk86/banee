rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function planFields() { return ['plan', 'planUntil', 'planSource', 'planProduct', 'planToken', 'planOrderId', 'planSyncedAt']; }
    function validPlan(p) { return p in ['free', 'key', 'starter', 'pro', 'business']; }

    // حساب المستخدم: يقرأ ويعدّل بياناته فقط
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.plan == 'free'
        && !request.resource.data.keys().hasAny(['planUntil', 'planToken', 'planOrderId']);
      allow update: if isOwner(uid)
        && validPlan(request.resource.data.get('plan', 'free'))
        && (
          // تعديل عادي لا يمس الخطة
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(planFields())
          // أو تفعيل خطة من Google Play: يجب أن يحمل رمز الشراء ورقم الطلب
          || (request.resource.data.planSource == 'google_play'
              && request.resource.data.planToken is string && request.resource.data.planToken.size() > 10
              && request.resource.data.planOrderId is string && request.resource.data.planOrderId.matches('GPA[.].+'))
          // أو الرجوع للخطة المجانية
          || request.resource.data.plan == 'free'
        );
      allow delete: if isOwner(uid);   // حذف الحساب من داخل التطبيق (متطلب Google Play)

      // مشاريع المستخدم (مقسّمة لأجزاء بسبب حد حجم المستند)
      match /apps/{appId} {
        allow read, write: if isOwner(uid);
        match /parts/{part} {
          allow read, write: if isOwner(uid)
            && (request.method == 'delete' || request.resource.data.d.size() <= 900000);
        }
      }
    }

    // ══ سحابة بانِي: بيانات التطبيقات المبنية ببانِي ══
    // apps/{appId}: صاحب التطبيق (owner) وأنماط مجموعاته (modes):
    //   content = محتوى عام (دروس، منتجات): يقرؤه الجميع، ويعدّله صاحب التطبيق فقط
    //   private = بيانات كل مستخدم (طلبات، حجوزات، تقدّم): صاحبها وصاحب التطبيق فقط
    //   shared  = مشترك بين المسجّلين (دردشة، تعليقات): يقرؤه المسجّلون، ويعدّل كلٌّ ما كتبه
    match /apps/{appId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.get('hostUntil', 0) <= request.time.toMillis() + 34560000000;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.get('hostUntil', 0) <= request.time.toMillis() + 34560000000;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      function appDoc() { return get(/databases/$(database)/documents/apps/$(appId)).data; }
      function appOwner() { return signedIn() && appDoc().owner == request.auth.uid; }
      function mode(col) { return appDoc().modes.get(col, 'private'); }
      function authorOf(d) { return d.get('userId', d.get('uid', d.get('ownerId', d.get('sellerId', d.get('providerId', d.get('teacherId', '')))))); }
      // الأدوار: apps/{appId}/members/{uid} = { role, status: ok | pending }
      // سحابة بانِي للتجربة فقط: بيانات التطبيق تتوقف إذا لم يُفتح في بانِي ٣٠ يوماً (بانِي يحدّث updatedAt عند كل معاينة)
      // التطبيق المنشور على سحابة بانِي (hostUntil): يعمل طوال مدة استضافته، والتي يجددها صاحبه مع كل تحديث
      function alive() { return appDoc().get('updatedAt', 0) > request.time.toMillis() - 2592000000 || appDoc().get('hostUntil', 0) > request.time.toMillis(); }
      function memberPath() { return /databases/$(database)/documents/apps/$(appId)/members/$(request.auth.uid); }
      function roleCan(col) {
        return signedIn() && col != 'members' && exists(memberPath())
          && get(memberPath()).data.status == 'ok'
          && get(memberPath()).data.role in appDoc().get('roleAccess', {}).get(col, []);
      }
      // العضو لا يمنح نفسه دوراً يحتاج موافقة: إما «قيد المراجعة» أو دور مفتوح
      function memberOk(d) {
        return d.get('status', '') == 'pending'
          || (d.get('status', '') == 'ok' && !(d.get('role', '') in appDoc().get('roleApprove', [])));
      }

      // أول حالة: المجموعة التي لها حالات (first) لا يُنشئ فيها المستخدم العادي عنصراً إلا بالحالة الأولى
      function firstOk(col, d) { return !(col in appDoc().get('first', {})) || d.get('status', '') == appDoc().first[col]; }
      // مجموعة يديرها دور (roleAccess): صاحب العنصر لا يغيّر مبلغه بعد الإنشاء
      function managed(col) { return appDoc().get('roleAccess', {}).get(col, []).size() > 0; }
      function moneySame() { return request.resource.data.get('price', null) == resource.data.get('price', null)
        && request.resource.data.get('amount', null) == resource.data.get('amount', null); }

      // عدّادات عامة (Tally): عدد العناصر القائمة لكل قيمة ربط (مواعيد محجوزة، مقاعد...). يقرؤها الجميع.
      // الكتابة مربوطة بعنصر حقيقي في نفس العملية (batch): العدّاد c__k__v لا يزيد إلا إذا أُنشئ/فُعّل في هذه العملية
      // عنصر في المجموعة c حقله k يساوي v، ولا ينقص إلا إذا حُذف أو أُلغي. فلا يستطيع أحد تزوير الأعداد أو «حجز» المواعيد وهمياً.
      function tLive(d) { return !(d.get('status', '') in ['cancelled', 'canceled', 'rejected', 'returned', 'expired', 'refunded', 'failed']); }
      function tPath(ref) { return /databases/$(database)/documents/apps/$(appId)/$(ref.split('/')[0])/$(ref.split('/')[1]); }
      function tBefore(d) { return exists(tPath(d.ref)) && tLive(get(tPath(d.ref)).data) && get(tPath(d.ref)).data.get(d.k, '') == d.v; }
      function tAfter(d) { return existsAfter(tPath(d.ref)) && tLive(getAfter(tPath(d.ref)).data) && getAfter(tPath(d.ref)).data.get(d.k, '') == d.v; }
      function tNum(data) { return data.get('amount', 0) is number ? data.get('amount', 0) : 0; }
      function tAmtB(d) { return tBefore(d) ? tNum(get(tPath(d.ref)).data) : 0; }
      function tAmtA(d) { return tAfter(d) ? tNum(getAfter(tPath(d.ref)).data) : 0; }
      function tallyOk(id, d, oldN, oldA) {
        return d.keys().hasOnly(['n', 'amount', 'ref', 'k', 'v'])
          && d.ref is string && d.k is string && d.v is string && d.ref.split('/').size() == 2 && d.k != 'userId'
          && id == (d.ref.split('/')[0] + '__' + d.k + '__' + d.v).replace('[/\\s]', '_')
          && ((d.n - oldN == 1 && tAfter(d) && !tBefore(d))
            || (d.n - oldN == -1 && tBefore(d) && !tAfter(d))
            || (d.n - oldN == 0 && tBefore(d) && tAfter(d)))
          && d.get('amount', 0) - oldA == tAmtA(d) - tAmtB(d);
      }
      match /_tally/{id} {
        allow read: if appOwner() || alive();
        allow create: if appOwner() || (signedIn() && alive() && tallyOk(id, request.resource.data, 0, 0));
        allow update: if appOwner() || (signedIn() && alive() && tallyOk(id, request.resource.data, resource.data.get('n', 0), resource.data.get('amount', 0)));
      }

      match /{col}/{id} {
        allow read: if appOwner() || (alive() && (mode(col) == 'content'
          || (mode(col) == 'shared' && signedIn())
          || roleCan(col)
          || (signedIn() && id == request.auth.uid)
          || (signedIn() && resource != null && authorOf(resource.data) == request.auth.uid)));
        allow create: if appOwner() || (alive() && (false
          // دور معتمد ينشر محتواه في مجموعة عامة (بائع يضيف منتجاته، معلم يضيف دروسه) باسمه هو فقط
          || (mode(col) == 'content' && roleCan(col) && authorOf(request.resource.data) == request.auth.uid)
          || (mode(col) == 'shared' && signedIn() && firstOk(col, request.resource.data))
          || (mode(col) == 'private' && signedIn()
              && (authorOf(request.resource.data) == request.auth.uid || id == request.auth.uid)
              && (firstOk(col, request.resource.data) || roleCan(col))
              && (col != 'members' || (id == request.auth.uid && memberOk(request.resource.data))))));
        allow update: if appOwner() || (alive() && (false
          || (roleCan(col) && authorOf(request.resource.data) == authorOf(resource.data)
              && (mode(col) != 'content' || authorOf(resource.data) == request.auth.uid))
          || (mode(col) != 'content' && signedIn()
              && (authorOf(resource.data) == request.auth.uid || id == request.auth.uid)
              && authorOf(request.resource.data) == authorOf(resource.data)
              && (!managed(col) || moneySame())
              && (col != 'members' || memberOk(request.resource.data)
                  || (request.resource.data.get('role', '') == resource.data.get('role', '')
                      && request.resource.data.get('status', '') == resource.data.get('status', ''))))));
        allow delete: if appOwner() || (alive() && (false
          || (mode(col) == 'content' && roleCan(col) && authorOf(resource.data) == request.auth.uid)
          || (mode(col) != 'content' && signedIn()
              && (authorOf(resource.data) == request.auth.uid || id == request.auth.uid))));
      }
    }

    // روابط المشاركة: نسخة ويب من التطبيق يقرؤها الجميع، ويكتبها صاحبها فقط
    match /pub/{slug} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && request.resource.data.owner == resource.data.owner;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /parts/{part} {
        allow read: if true;
        allow write: if signedIn() && get(/databases/$(database)/documents/pub/$(slug)).data.owner == request.auth.uid
          && (request.method == 'delete' || request.resource.data.d.size() <= 900000);
      }
    }

    // قناة التحديث الفوري: التطبيقات المثبتة تقرأ آخر نسخة، وصاحب التطبيق وحده ينشرها، ورقم النسخة لا ينقص
    match /live/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && request.resource.data.owner == resource.data.owner
        && request.resource.data.v >= resource.data.v;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /parts/{part} {
        allow read: if true;
        allow write: if signedIn() && get(/databases/$(database)/documents/live/$(id)).data.owner == request.auth.uid
          && (request.method == 'delete' || request.resource.data.d.size() <= 900000);
      }
    }

    // ملفات البناء السحابي (APK): معرّف عشوائي طويل، يقرؤها سير عمل GitHub، ويكتبها صاحبها فقط
    match /apk/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && id.size() == 20;
      allow update, delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /parts/{part} {
        allow read: if true;
        allow write: if signedIn() && get(/databases/$(database)/documents/apk/$(id)).data.owner == request.auth.uid
          && (request.method == 'delete' || request.resource.data.d.size() <= 900000);
      }
    }

    // أي شيء آخر ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
