rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function planFields() { return ['plan', 'planUntil', 'planSource', 'planProduct', 'planToken', 'planOrderId', 'planSyncedAt']; }
    function validPlan(p) { return p in ['free', 'starter', 'pro', 'business']; }

    // حساب المستخدم: يقرأ ويعدّل بياناته فقط
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.plan == 'free'
        && !request.resource.data.keys().hasAny(['planUntil', 'planToken', 'planOrderId']);
      allow update: if isOwner(uid)
        && validPlan(request.resource.data.get('plan', 'free'))
        && (
          // تعديل عادي لا يمس الخطة
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(planFields())
          // أو تفعيل خطة من Google Play: يجب أن يحمل رمز الشراء ورقم الطلب
          || (request.resource.data.planSource == 'google_play'
              && request.resource.data.planToken is string && request.resource.data.planToken.size() > 10
              && request.resource.data.planOrderId is string && request.resource.data.planOrderId.matches('GPA[.].+'))
          // أو الرجوع للخطة المجانية
          || request.resource.data.plan == 'free'
        );
      allow delete: if false;

      // مشاريع المستخدم (مقسّمة لأجزاء بسبب حد حجم المستند)
      match /apps/{appId} {
        allow read, write: if isOwner(uid);
        match /parts/{part} {
          allow read, write: if isOwner(uid)
            && (request.method == 'delete' || request.resource.data.d.size() <= 900000);
        }
      }
    }

    // أي شيء آخر ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
